{
  "name": "seaovers-mediasuite",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:lib dev:cms",
    "dev:lib": "cd packages/seaovers-media && npm run dev",
    "dev:cms": "cd apps/cms && npm run dev",
    "build": "npm run build:lib && npm run build:cms",
    "build:lib": "cd packages/seaovers-media && npm run build",
    "build:cms": "cd apps/cms && npm run build"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
