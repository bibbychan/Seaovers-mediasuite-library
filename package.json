{
  "name": "seaovers-mediasuite",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:lib dev:cms",
    "dev:lib": "cd packages/seaovers-media && npm run dev",
    "dev:cms": "cd apps/cms && npm run dev",
    "build": "npm run build:lib && npm run build:cms",
    "build:lib": "cd packages/seaovers-media && npm run build",
    "build:cms": "cd apps/cms && npm run build",
    "db:generate": "cd packages/seaovers-media && npm run db:generate",
    "db:push": "cd packages/seaovers-media && npm run db:push",
    "db:migrate": "cd packages/seaovers-media && npm run db:migrate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "tsx": "^4.21.0",
    "csv-parse": "^6.2.1",
    "prisma": "^5.22.0",
    "@prisma/client": "^5.22.0"
  }
}